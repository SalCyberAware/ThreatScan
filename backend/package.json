{
  "name": "threatscan-backend",
  "version": "1.0.0",
  "description": "ThreatScan backend proxy",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "jest",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "axios": "^1.7.2",
    "cors": "^2.8.5",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "supertest": "^7.3.1"
  },
  "engines": {
    "node": "24.x"
  },
  "jest": {
    "testEnvironment": "node",
    "forceExit": true,
    "collectCoverageFrom": [
      "server.js",
      "engines/*.js",
      "utils/*.js",
      "!**/*.test.js",
      "!**/node_modules/**"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text-summary",
      "text",
      "lcov"
    ]
  }
}
